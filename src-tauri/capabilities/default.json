{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**/*.mkv" },
        { "path": "**/*.mp4" },
        { "path": "**/*.m4v" },
        { "path": "**/*.mov" },
        { "path": "**/*.avi" },
        { "path": "**/*.ts" },
        { "path": "**/*.m2ts" },
        { "path": "**/*.mpg" },
        { "path": "**/*.mpeg" },
        { "path": "**/*.vob" },
        { "path": "**/*.MKV" },
        { "path": "**/*.MP4" },
        { "path": "**/*.M4V" },
        { "path": "**/*.MOV" },
        { "path": "**/*.AVI" },
        { "path": "**/*.TS" },
        { "path": "**/*.M2TS" },
        { "path": "**/*.MPG" },
        { "path": "**/*.MPEG" },
        { "path": "**/*.VOB" }
      ]
    }
  ]
}
